<Window
    x:Class="CXAudioOutput.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CXAudioOutput.ViewModels"
    Title="CX Audio Output">

    <Grid x:Name="RootGrid" Background="{StaticResource PageGradientBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="18,0,150,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Width="36" Height="36" Source="ms-appx:///Assets/logo.png"
                       Stretch="Uniform" AutomationProperties.Name="CX Audio Output" />
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="CX Audio Output" FontFamily="{StaticResource DisplayFont}"
                               FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="NATIVE SPEAKER CONTROL" Style="{StaticResource EyebrowStyle}"
                               FontSize="8" CharacterSpacing="140" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border x:Name="ServicePill" Style="{StaticResource StatusPillStyle}" Background="{StaticResource AcidSoftBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="ServiceDot" Width="6" Height="6" Fill="{StaticResource WarningBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="ServicePillText" Text="正在启动" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Button x:Name="OpenBrowserButton" Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="打开网页控制台"
                        ToolTipService.ToolTip="打开网页控制台" Click="OpenBrowser_Click">
                    <FontIcon Glyph="&#xE774;" FontSize="15" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentStack" MaxWidth="1480" Padding="26,8,26,26" Spacing="16">
                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True"
                         Title="服务未能启动" Margin="0,-4,0,0" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource HeroCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse x:Name="LiveDot" Width="7" Height="7"
                                                 Fill="{StaticResource AcidBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="StatusEyebrow" Text="SYSTEM AUDIO · LIVE"
                                                   Style="{StaticResource EyebrowStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="StatusHeadline" Text="正在把声音送出去。"
                                               FontFamily="{StaticResource DisplayFont}" FontSize="35"
                                               FontWeight="SemiBold" CharacterSpacing="-35"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="SourceText" Text="正在准备默认音频输出设备…"
                                               Style="{StaticResource BodyMutedStyle}" MaxWidth="720" />
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <TextBlock x:Name="SampleText" Style="{StaticResource CaptionStyle}"
                                                   Text="48 kHz · STEREO · 16-BIT" />
                                        <TextBlock Text="·" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock x:Name="UptimeText" Style="{StaticResource CaptionStyle}"
                                                   Text="服务启动中" />
                                    </StackPanel>
                                </StackPanel>
                                <Button x:Name="PauseButton" Grid.Column="1" Style="{StaticResource LimeButtonStyle}"
                                        VerticalAlignment="Top" AutomationProperties.Name="暂停或继续串流"
                                        Click="Pause_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="14" />
                                        <TextBlock x:Name="PauseText" Text="暂停串流" FontWeight="SemiBold"
                                                   FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid Grid.Row="1" Height="132" Margin="0,18,0,14">
                                <Canvas x:Name="AudioMeterCanvas" HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" SizeChanged="AudioMeter_SizeChanged" />
                                <TextBlock x:Name="PeakText" Text="−∞ dB" HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            </Grid>

                            <Grid Grid.Row="2" ColumnSpacing="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="主音量" Style="{StaticResource CaptionStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="MasterVolumeText" Grid.Column="1" Text="100%"
                                                   FontFamily="{StaticResource DisplayFont}" FontSize="11"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="MuteButton" Style="{StaticResource IconButtonStyle}"
                                                Width="34" Height="34" Click="Mute_Click"
                                                AutomationProperties.Name="静音"
                                                ToolTipService.ToolTip="静音">
                                            <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="15" />
                                        </Button>
                                        <Slider x:Name="MasterVolumeSlider" Minimum="0" Maximum="100"
                                                StepFrequency="1" Value="100" Width="250"
                                                AutomationProperties.Name="主音量"
                                                ValueChanged="MasterVolume_ValueChanged" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="延迟配置" Style="{StaticResource CaptionStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="LatencyText" Grid.Column="1" Text="180 ms"
                                                   FontFamily="{StaticResource DisplayFont}" FontSize="11"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                    <ComboBox x:Name="LatencyComboBox" HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="延迟配置"
                                              SelectionChanged="Latency_SelectionChanged">
                                        <ComboBoxItem Content="低延迟 · 120 ms" Tag="low" />
                                        <ComboBoxItem Content="均衡 · 240 ms" Tag="balanced" />
                                        <ComboBoxItem Content="稳定 · 450 ms" Tag="stable" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource AppCardStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="扫码收听" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="手机、平板或另一台电脑" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource StatusPillStyle}"
                                        Background="{StaticResource AcidSoftBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="LIVE" FontFamily="{StaticResource DisplayFont}" FontSize="9"
                                               FontWeight="SemiBold" Foreground="{StaticResource AcidBrush}"
                                               CharacterSpacing="100" />
                                </Border>
                            </Grid>

                            <Border Grid.Row="1" Width="198" Height="198" Background="White" CornerRadius="17"
                                    Padding="10" HorizontalAlignment="Center" Margin="0,3,0,0">
                                <Grid>
                                    <Image x:Name="QrImage" Stretch="Uniform" />
                                    <StackPanel x:Name="QrPlaceholder" HorizontalAlignment="Center"
                                                VerticalAlignment="Center" Spacing="6">
                                        <FontIcon Glyph="&#xE701;" FontSize="24" Foreground="#1A1E18" />
                                        <TextBlock Text="选择可用网卡后显示二维码" FontSize="10" Foreground="#5D665A"
                                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="145" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="2" Text="打开链接，把浏览器变成扬声器。"
                                       Style="{StaticResource CaptionStyle}" TextAlignment="Center" />

                            <Grid Grid.Row="3" Padding="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="访问码" Style="{StaticResource CaptionStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="AccessCodeText" Grid.Column="1" Text="······"
                                           FontFamily="{StaticResource DisplayFont}" FontSize="21"
                                           FontWeight="SemiBold" Foreground="{StaticResource AcidBrush}"
                                           CharacterSpacing="100" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="8,0,0,0">
                                    <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                                            Click="CopyCode_Click" AutomationProperties.Name="复制访问码"
                                            ToolTipService.ToolTip="复制访问码">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                                            Click="RotateCode_Click" AutomationProperties.Name="更换访问码"
                                            ToolTipService.ToolTip="更换访问码">
                                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <ComboBox x:Name="AddressComboBox" Grid.Row="4" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="收听链接网卡地址"
                                      PlaceholderText="选择网卡地址" SelectionChanged="Address_SelectionChanged"
                                      DisplayMemberPath="Display" />

                            <Grid Grid.Row="5" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ShareUrlText" Text="正在准备链接…"
                                           Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button x:Name="CopyLinkButton" Grid.Column="1" Style="{StaticResource GhostButtonStyle}"
                                        Padding="10,5" MinHeight="30" Click="CopyLink_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                        <TextBlock Text="复制" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock Grid.Row="6" Text="仅限本地网络 · 音频不会上传云端"
                                       Style="{StaticResource CaptionStyle}" TextAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Style="{StaticResource AppCardStyle}" Padding="24,22,24,20">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="网络接口" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="只有勾选的网卡会接受其他设备连接；本机控制台始终可访问。"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                        VerticalAlignment="Center">
                                <TextBlock Text="允许多选" Style="{StaticResource CaptionStyle}"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="MultiSelectSwitch" IsOn="True" MinWidth="0"
                                              AutomationProperties.Name="允许多选网卡"
                                              Toggled="MultiSelect_Toggled" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="NetworkSummaryText" Text="正在扫描网卡…"
                                           FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="UpdateStampText" Text="硬件状态 · 等待更新"
                                           Style="{StaticResource CaptionStyle}" FontSize="10" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="SelectAllButton" Style="{StaticResource GhostButtonStyle}"
                                        Padding="10,5" MinHeight="30" Click="SelectAll_Click">
                                    <TextBlock Text="全选物理" FontSize="10" />
                                </Button>
                                <Button x:Name="ClearNetworkButton" Style="{StaticResource GhostButtonStyle}"
                                        Padding="10,5" MinHeight="30" Click="ClearNetwork_Click">
                                    <TextBlock Text="仅本机" FontSize="10" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32"
                                        Click="RefreshNetwork_Click" ToolTipService.ToolTip="刷新硬件状态">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <InfoBar x:Name="NetworkWarningBar" Grid.Row="2" Severity="Warning" IsOpen="False"
                                 IsClosable="False" />

                        <Grid Grid.Row="3">
                            <ListView x:Name="AdapterList" SelectionMode="None" IsItemClickEnabled="False"
                                      ItemContainerStyle="{StaticResource PlainListViewItemStyle}"
                                      MaxHeight="330" Padding="0" Background="Transparent"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NetworkAdapterViewModel">
                                        <Grid Background="#08FFFFFF" BorderBrush="#16F0F5E9"
                                              BorderThickness="1" CornerRadius="14" Padding="12,10"
                                              ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                                      AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                                      Tag="{x:Bind Id}" Click="AdapterCheckBox_Click"
                                                      VerticalAlignment="Center" MinWidth="0" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="13"
                                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Border Background="{x:Bind StatusPillBrush, Mode=OneWay}"
                                                            CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <Ellipse Width="5" Height="5"
                                                                     Fill="{x:Bind StatusBrush, Mode=OneWay}"
                                                                     VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                                       FontSize="9" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#12FFFFFF" CornerRadius="8" Padding="5,2"
                                                            Visibility="{x:Bind VirtualVisibility, Mode=OneWay}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="虚拟" FontSize="8"
                                                                   Foreground="{StaticResource TextMutedBrush}" />
                                                    </Border>
                                                    <Border Background="#1AD8FF65" CornerRadius="8" Padding="5,2"
                                                            Visibility="{x:Bind UsbTetherVisibility, Mode=OneWay}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="USB" FontSize="8"
                                                                   Foreground="{StaticResource AcidBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind DescriptionLine, Mode=OneWay}"
                                                           Style="{StaticResource CaptionStyle}" FontSize="10"
                                                           MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Text="{x:Bind IpText, Mode=OneWay}" FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind SpeedText, Mode=OneWay}" FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind TypeLabel, Mode=OneWay}" FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{x:Bind MacText, Mode=OneWay}" FontSize="9"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource AppCardStyle}" Padding="24,22,24,20">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Android 有线连接" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="用 USB 数据线把手机变成有线扬声器，不需要 Wi-Fi；延迟更低，也不受路由器影响。"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource StatusPillStyle}"
                                    Background="{StaticResource AcidSoftBrush}" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse x:Name="AndroidWiredDot" Width="6" Height="6"
                                             Fill="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AndroidWiredPillText" Text="未检测到设备"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#08FFFFFF" BorderBrush="#16F0F5E9"
                                    BorderThickness="1" CornerRadius="14" Padding="15">
                                <StackPanel Spacing="9">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Border Width="26" Height="26" CornerRadius="9"
                                                Background="{StaticResource AcidSoftBrush}">
                                            <TextBlock Text="1" FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AcidBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="USB 网络共享" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="免开发者选项 · 推荐" Style="{StaticResource CaptionStyle}"
                                                       FontSize="9" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="在手机上打开“USB 网络共享 / USB 共享网络”，电脑会自动出现一块 USB 网卡。"
                                               Style="{StaticResource BodyMutedStyle}" FontSize="10" />
                                    <TextBlock x:Name="AndroidTetherStatusText" Text="正在检测 USB 网卡…"
                                               Style="{StaticResource CaptionStyle}" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Button x:Name="UseTetherButton" Style="{StaticResource LimeButtonStyle}"
                                                Padding="12,6" MinHeight="32" Click="UseAndroidTether_Click"
                                                AutomationProperties.Name="使用 USB 网卡">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE703;" FontSize="12" />
                                                <TextBlock x:Name="UseTetherButtonText" Text="使用 USB 网卡"
                                                           FontSize="10" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostButtonStyle}" Padding="10,6"
                                                MinHeight="32" Click="RefreshAndroid_Click"
                                                AutomationProperties.Name="重新检测 Android 设备"
                                                ToolTipService.ToolTip="重新检测 Android 设备">
                                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#08FFFFFF" BorderBrush="#16F0F5E9"
                                    BorderThickness="1" CornerRadius="14" Padding="15">
                                <StackPanel Spacing="9">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Border Width="26" Height="26" CornerRadius="9"
                                                Background="{StaticResource AcidSoftBrush}">
                                            <TextBlock Text="2" FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AcidBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="ADB 有线通道" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="需要 USB 调试 · 手机走 localhost" Style="{StaticResource CaptionStyle}"
                                                       FontSize="9" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="开启开发者选项和 USB 调试，授权电脑后用 adb reverse 建立通道；手机访问 127.0.0.1，属于安全上下文。"
                                               Style="{StaticResource BodyMutedStyle}" FontSize="10" />
                                    <ComboBox x:Name="AndroidDeviceComboBox" HorizontalAlignment="Stretch"
                                              PlaceholderText="选择 Android 设备" DisplayMemberPath="Display"
                                              AutomationProperties.Name="选择 Android 设备"
                                              SelectionChanged="AndroidDevice_SelectionChanged" />
                                    <TextBlock x:Name="AndroidAdbStatusText" Text="正在检测 adb…"
                                               Style="{StaticResource CaptionStyle}" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Button x:Name="AndroidReverseButton" Style="{StaticResource LimeButtonStyle}"
                                                Padding="12,6" MinHeight="32" Click="AndroidReverse_Click"
                                                AutomationProperties.Name="建立有线通道">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE703;" FontSize="12" />
                                                <TextBlock x:Name="AndroidReverseButtonText" Text="建立有线通道"
                                                           FontSize="10" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="AndroidStopReverseButton" Style="{StaticResource GhostButtonStyle}"
                                                Padding="10,6" MinHeight="32" Click="AndroidStopReverse_Click"
                                                AutomationProperties.Name="关闭有线通道">
                                            <TextBlock Text="关闭通道" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Button x:Name="AndroidPickAdbButton" Style="{StaticResource GhostButtonStyle}"
                                                Padding="10,6" MinHeight="30" Click="AndroidPickAdb_Click"
                                                AutomationProperties.Name="选择 adb.exe">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="11" />
                                                <TextBlock Text="选择 adb" FontSize="10" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="AndroidOpenPhoneButton" Style="{StaticResource GhostButtonStyle}"
                                                Padding="10,6" MinHeight="30" Click="AndroidOpenPhone_Click"
                                                AutomationProperties.Name="在手机上打开有线收听页面">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE8A7;" FontSize="11" />
                                                <TextBlock Text="在手机上打开" FontSize="10" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Background="#06FFFFFF" BorderBrush="#12F0F5E9"
                                BorderThickness="1" CornerRadius="14" Padding="14,12">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="有线收听地址" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AndroidWiredUrlText" Text="建立通道后显示"
                                               Style="{StaticResource CaptionStyle}" FontSize="10"
                                               IsTextSelectionEnabled="True"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Button x:Name="CopyAndroidUrlButton" Style="{StaticResource GhostButtonStyle}"
                                                Padding="10,5" MinHeight="30" Click="CopyAndroidUrl_Click"
                                                AutomationProperties.Name="复制有线收听链接">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                                <TextBlock Text="复制链接" FontSize="10" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="AndroidWiredHintText"
                                                   Text="建立任一有线通道后显示收听地址。"
                                                   Style="{StaticResource CaptionStyle}" FontSize="9"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Width="98" Height="98" Background="White"
                                        CornerRadius="13" Padding="6">
                                    <Grid>
                                        <Image x:Name="AndroidQrImage" Stretch="Uniform" />
                                        <TextBlock x:Name="AndroidQrPlaceholder" Text="USB"
                                                   FontFamily="{StaticResource DisplayFont}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#5D665A"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <InfoBar x:Name="AndroidWiredInfoBar" Grid.Row="3" Severity="Informational"
                                 IsOpen="False" IsClosable="True" />
                        <TextBlock Grid.Row="4"
                                   Text="有线音频只在本机与数据线之间传输。使用 ADB 通道时手机会访问 localhost，接收端会优先启用 AudioWorklet；USB 网络共享则使用兼容模式。"
                                   Style="{StaticResource CaptionStyle}" FontSize="9"
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource AppCardStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="接收设备" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="已连接的浏览器扬声器" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource StatusPillStyle}"
                                        Background="{StaticResource AcidSoftBrush}">
                                    <TextBlock x:Name="ReceiverCountText" Text="0 台"
                                               FontFamily="{StaticResource DisplayFont}" FontSize="10"
                                               Foreground="{StaticResource AcidBrush}" />
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1">
                                <ListView x:Name="ReceiverList" SelectionMode="None"
                                          ItemContainerStyle="{StaticResource PlainListViewItemStyle}"
                                          MaxHeight="250" Background="Transparent" Padding="0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReceiverViewModel">
                                            <Grid Background="#08FFFFFF" BorderBrush="#16F0F5E9"
                                                  BorderThickness="1" CornerRadius="14" Padding="12"
                                                  ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="38" Height="38" CornerRadius="12"
                                                        Background="{StaticResource AcidSoftBrush}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Initial, Mode=OneWay}" FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AcidBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="13"
                                                                   FontWeight="SemiBold" />
                                                        <Ellipse Width="5" Height="5"
                                                                 Fill="{x:Bind StatusBrush, Mode=OneWay}"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind PlaybackText, Mode=OneWay}"
                                                                   FontSize="9"
                                                                   Foreground="{StaticResource TextMutedBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Meta, Mode=OneWay}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               FontSize="9" />
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <TextBlock Text="{x:Bind BufferText, Mode=OneWay}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind RttText, Mode=OneWay}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextMutedBrush}" />
                                                        <TextBlock Text="{x:Bind VolumeText, Mode=OneWay}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextMutedBrush}" />
                                                        <TextBlock Text="{x:Bind HealthText, Mode=OneWay}"
                                                                   FontSize="10"
                                                                   Foreground="{x:Bind HealthBrush, Mode=OneWay}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource IconButtonStyle}" Width="30"
                                                            Height="30" Tag="{x:Bind Id, Mode=OneWay}"
                                                            Click="IdentifyReceiver_Click"
                                                            ToolTipService.ToolTip="播放提示音">
                                                        <FontIcon Glyph="&#xE767;" FontSize="12" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButtonStyle}" Width="30"
                                                            Height="30" Tag="{x:Bind Id, Mode=OneWay}"
                                                            Click="KickReceiver_Click"
                                                            ToolTipService.ToolTip="断开设备">
                                                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="ReceiverEmptyText"
                                           Text="还没有扬声器加入。扫描右侧二维码开始连接。"
                                           Style="{StaticResource BodyMutedStyle}" TextAlignment="Center"
                                           Margin="12,24" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="9">
                            <TextBlock Text="系统" Style="{StaticResource CardTitleStyle}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="服务端口" Style="{StaticResource CaptionStyle}" />
                                <TextBlock x:Name="PortText" Grid.Column="1" Text="5240" FontSize="11"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="网页控制台" Style="{StaticResource CaptionStyle}" />
                                <TextBlock x:Name="WebUrlText" Grid.Column="1" Text="—"
                                           Style="{StaticResource CaptionStyle}" FontSize="10"
                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="音频设备" Style="{StaticResource CaptionStyle}" />
                                <TextBlock x:Name="AudioDeviceText" Grid.Column="1" Text="—"
                                           Style="{StaticResource CaptionStyle}" FontSize="10"
                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="配置文件" Style="{StaticResource CaptionStyle}" />
                                <TextBlock x:Name="SettingsPathText" Grid.Column="1" Text="—"
                                           Style="{StaticResource CaptionStyle}" FontSize="9"
                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,4" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Style="{StaticResource GhostButtonStyle}" Padding="10,5" MinHeight="30"
                                        Click="OpenLogFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE838;" FontSize="11" />
                                        <TextBlock Text="日志" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButtonStyle}" Padding="10,5" MinHeight="30"
                                        Click="OpenSettingsFolder_Click">
                                    <TextBlock Text="设置目录" FontSize="10" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="硬件状态自动刷新 · 音频状态实时同步"
                                       Style="{StaticResource CaptionStyle}" FontSize="9"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="CX AUDIO OUTPUT  ·  LOCAL NETWORK ONLY  ·  v1.3.0"
                           Style="{StaticResource EyebrowStyle}" FontSize="8"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
