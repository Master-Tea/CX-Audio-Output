<Application
    x:Class="CXAudioOutput.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="SystemAccentColor">#D8FF65</Color>
            <Color x:Key="SystemAccentColorLight1">#E3FF93</Color>
            <Color x:Key="SystemAccentColorLight2">#ECFFB8</Color>
            <Color x:Key="SystemAccentColorLight3">#F4FFD9</Color>
            <Color x:Key="SystemAccentColorDark1">#C4F24A</Color>
            <Color x:Key="SystemAccentColorDark2">#A8D52E</Color>
            <Color x:Key="SystemAccentColorDark3">#82A91E</Color>

            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#080A09" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#121613" />
            <SolidColorBrush x:Key="PanelBackgroundSoftBrush" Color="#0E1210" />
            <SolidColorBrush x:Key="PanelStrokeBrush" Color="#24F0F5E9" />
            <SolidColorBrush x:Key="PanelStrokeStrongBrush" Color="#40F0F5E9" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F4E9" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A5AEA1" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#727B6F" />
            <SolidColorBrush x:Key="AcidBrush" Color="#D8FF65" />
            <SolidColorBrush x:Key="AcidSoftBrush" Color="#1FD8FF65" />
            <SolidColorBrush x:Key="AcidFaintBrush" Color="#0DD8FF65" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFC166" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF746C" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FFF746C" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#A8E86F" />
            <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

            <LinearGradientBrush x:Key="PageGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0C100D" Offset="0" />
                <GradientStop Color="#080A09" Offset="0.55" />
                <GradientStop Color="#090B09" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A2218" Offset="0" />
                <GradientStop Color="#111611" Offset="0.55" />
                <GradientStop Color="#0B0E0C" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="PanelGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#171D18" Offset="0" />
                <GradientStop Color="#0D110F" Offset="1" />
            </LinearGradientBrush>

            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display</FontFamily>
            <FontFamily x:Key="BodyFont">Segoe UI Variable Text</FontFamily>

            <Style x:Key="AppCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelGradientBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Padding" Value="24" />
            </Style>

            <Style x:Key="HeroCardStyle" TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
                <Setter Property="Background" Value="{StaticResource HeroGradientBrush}" />
                <Setter Property="Padding" Value="28" />
            </Style>

            <Style x:Key="EyebrowStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="150" />
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-20" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <Style x:Key="BodyMutedStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="LimeButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AcidBrush}" />
                <Setter Property="Foreground" Value="#0A0C08" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="GhostButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#0CFFFFFF" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelStrokeStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="11" />
            </Style>

            <Style x:Key="StatusPillStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="9,4" />
                <Setter Property="Background" Value="{StaticResource AcidSoftBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PlainListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MinHeight" Value="36" />
            </Style>

            <Style TargetType="FontIcon">
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            </Style>

            <Style TargetType="Slider">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
